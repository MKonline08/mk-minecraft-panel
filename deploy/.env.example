# Copy to deploy/.env and fill in. Never commit the real .env.

# Your domain, already pointing (A/AAAA record) at this machine.
PANEL_DOMAIN=panel.example.com
# Email for Let's Encrypt expiry notices (optional).
ACME_EMAIL=

# Required: one-time secret you type on the first-run setup screen.
# Generate with:  openssl rand -hex 24
SETUP_TOKEN=

# Host folder holding all panel data (must be a host path, not a named volume).
HOST_DATA_DIR=/DATA/AppData/mk-minecraft-panel

# Pin a release instead of "latest" for predictable upgrades, e.g. 1.6.0
PANEL_VERSION=latest

# Optional: needed only for CurseForge manifest imports.
CURSEFORGE_API_KEY=
